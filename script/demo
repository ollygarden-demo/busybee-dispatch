#!/bin/sh
set -eu

cd "$(dirname "$0")/.."
if docker compose version >/dev/null 2>&1; then
  compose="docker compose"
else
  compose="docker-compose"
fi
api=${BUSYBEE_URL:-http://localhost:3000}
routing=${ROUTING_CONTROL_URL:-http://localhost:9292}
hub_id=11111111-1111-4111-8111-111111111111
paused_sidekiq=false
stopped_localstack=false
queue_visibility_changed=false

cleanup() {
  curl -fsS -X POST "$routing/control/reset" >/dev/null || true
  [ "$paused_sidekiq" = false ] || $compose unpause sidekiq >/dev/null
  [ "$stopped_localstack" = false ] || $compose start localstack >/dev/null
  if [ "$queue_visibility_changed" = true ]; then
    $compose exec -T localstack awslocal sqs set-queue-attributes --queue-url http://localhost:4566/000000000000/busybee-deliveries --attributes VisibilityTimeout=120 >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

uuid() {
  uuidgen | tr '[:upper:]' '[:lower:]'
}

rails() {
  $compose exec -T api bin/rails runner "$1"
}

reset_demo() {
  $compose stop sidekiq shoryuken >/dev/null
  $compose exec -T redis redis-cli -n 0 FLUSHDB >/dev/null
  $compose exec -T redis redis-cli -n 2 FLUSHDB >/dev/null
  rails 'OutboxEvent.delete_all; HttpIdempotencyRecord.delete_all; Delivery.destroy_all' >/dev/null
  $compose exec -T localstack awslocal sqs purge-queue --queue-url http://localhost:4566/000000000000/busybee-deliveries >/dev/null 2>&1 || true
  $compose exec -T localstack awslocal sqs purge-queue --queue-url http://localhost:4566/000000000000/busybee-deliveries-dlq >/dev/null 2>&1 || true
  $compose exec -T api bin/rails db:seed >/dev/null
  curl -fsS -X POST "$routing/control/reset" >/dev/null
  $compose start sidekiq shoryuken >/dev/null
}

reset_demo
token=$(rails 'puts JWT.encode({sub: "demo-operator", iss: "busybee-dispatch", aud: "busybee-api", exp: 1.hour.from_now.to_i}, ENV.fetch("JWT_SECRET"), "HS256")')

create_delivery() {
  external_id=$1
  longitude=${2:-13.405}
  latitude=${3:-52.520}
  curl -fsS -X POST "$api/api/v1/deliveries" \
    -H "Authorization: Bearer $token" \
    -H "Idempotency-Key: $external_id" \
    -H "Content-Type: application/json" \
    -d "{\"external_id\":\"$external_id\",\"hub_id\":\"$hub_id\",\"pickup\":{\"coordinates\":[$longitude,$latitude]},\"dropoff\":{\"coordinates\":[13.3777,52.5163]},\"recipient\":{\"name\":\"Demo Recipient\",\"phone\":\"+4915112345678\"}}"
  rails 'OutboxDispatcherJob.perform_async' >/dev/null
}

send_event() {
  body=$1
  $compose exec -T localstack awslocal sqs send-message \
    --queue-url http://localhost:4566/000000000000/busybee-deliveries \
    --message-body "$body" >/dev/null
}

wait_for_state() {
  external_id=$1
  expected=$2
  attempts=0
  while [ "$attempts" -lt 30 ]; do
    state=$(rails "delivery = Delivery.find_by(external_id: '$external_id'); puts delivery&.current_state")
    [ "$state" != "$expected" ] || return 0
    attempts=$((attempts + 1))
    sleep 1
  done
  echo "Timed out waiting for $external_id to become $expected (last state: $state)" >&2
  return 1
}

case "${1:-}" in
  happy-path)
    external_id=$(uuid)
    create_delivery "$external_id" >/dev/null
    wait_for_state "$external_id" assigned
    delivery_id=$(rails "puts Delivery.find_by!(external_id: '$external_id').id")
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    curl -fsS -X POST "$api/api/v1/deliveries/$delivery_id/pick_up" -H "Authorization: Bearer $token" -H "Idempotency-Key: $(uuid)" -H "Content-Type: application/json" -d "{\"occurred_at\":\"$now\"}" >/dev/null
    curl -fsS -X POST "$api/api/v1/deliveries/$delivery_id/deliver" -H "Authorization: Bearer $token" -H "Idempotency-Key: $(uuid)" -H "Content-Type: application/json" -d "{\"occurred_at\":\"$now\",\"proof\":{\"type\":\"recipient_confirmation\",\"note\":\"synthetic demo text\"}}"
    rails 'OutboxDispatcherJob.perform_async' >/dev/null
    ;;
  no-courier)
    rails 'Courier.update_all(availability: "offline")' >/dev/null
    external_id=$(uuid)
    create_delivery "$external_id" >/dev/null
    sleep 3
    rails "delivery = Delivery.find_by!(external_id: '$external_id'); puts({id: delivery.id, state: delivery.current_state, attempts: delivery.dispatch_attempts.pluck(:outcome, :reason)}.to_json)"
    rails "delivery = Delivery.find_by!(external_id: '$external_id'); DeliveryTransitioner.call(delivery, :cancelled, metadata: {reason: 'operator_request'}) if delivery.current_state == 'pending'" >/dev/null
    ;;
  slow-routing)
    curl -fsS -X POST "$routing/control" -H 'Content-Type: application/json' -d '{"mode":"normal","delay_ms":2000}' >/dev/null
    external_id=$(uuid)
    create_delivery "$external_id" >/dev/null
    wait_for_state "$external_id" assigned
    rails "puts DispatchAttempt.where(delivery: Delivery.find_by!(external_id: '$external_id')).last.attributes.slice('outcome', 'duration_ms').to_json"
    ;;
  circuit-open)
    curl -fsS -X POST "$routing/control" -H 'Content-Type: application/json' -d '{"mode":"error","failures":20}' >/dev/null
    count=0
    while [ "$count" -lt 6 ]; do create_delivery "$(uuid)" >/dev/null; count=$((count + 1)); done
    sleep 5
    rails 'puts DispatchAttempt.order(created_at: :desc).limit(6).pluck(:outcome, :reason).to_json'
    ;;
  duplicate-event)
    external_id=$(uuid)
    create_delivery "$external_id" >/dev/null
    create_delivery "$external_id" >/dev/null
    event_id=$(uuid)
    event="{\"event_id\":\"$event_id\",\"external_id\":\"$(uuid)\",\"hub_id\":\"$hub_id\",\"occurred_at\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"pickup\":{\"coordinates\":[13.405,52.52]},\"dropoff\":{\"coordinates\":[13.3777,52.5163]},\"recipient\":{\"name\":\"Demo Recipient\",\"phone\":\"+4915112345678\"}}"
    send_event "$event"
    send_event "$event"
    echo "Sent duplicate HTTP external ID and duplicate SQS event ID $event_id"
    ;;
  lock-contention)
    curl -fsS -X POST "$routing/control" -H 'Content-Type: application/json' -d '{"mode":"normal","delay_ms":1000}' >/dev/null
    $compose pause sidekiq >/dev/null
    paused_sidekiq=true
    external_id=$(uuid)
    create_delivery "$external_id" >/dev/null
    delivery_id=$(rails "puts Delivery.find_by!(external_id: '$external_id').id")
    rails "threads = 2.times.map { Thread.new { AssignmentService.new(Delivery.find('$delivery_id')).call } }; puts threads.map(&:value).map { |result| {outcome: result.outcome, reason: result.reason} }.to_json"
    $compose unpause sidekiq >/dev/null
    paused_sidekiq=false
    rails "delivery = Delivery.find('$delivery_id'); puts({state: delivery.current_state, courier_id: delivery.courier_id, attempts: delivery.dispatch_attempts.count}.to_json)"
    ;;
  queue-backlog)
    $compose pause sidekiq >/dev/null
    paused_sidekiq=true
    count=0
    while [ "$count" -lt 25 ]; do create_delivery "$(uuid)" >/dev/null; count=$((count + 1)); done
    rails 'OutboxDispatcherJob.new.perform; puts({queued: Sidekiq::Queue.new("dispatch").size}.to_json)'
    $compose unpause sidekiq >/dev/null
    paused_sidekiq=false
    ;;
  aws-retry)
    external_id=$(uuid)
    create_delivery "$external_id" >/dev/null
    wait_for_state "$external_id" assigned
    delivery_id=$(rails "puts Delivery.find_by!(external_id: '$external_id').id")
    event_id=$(rails "puts OutboxEvent.create!(event_type: 'assignment_notification', aggregate_id: '$delivery_id', payload: {outcome: 'assigned'}).id")
    $compose stop localstack >/dev/null
    stopped_localstack=true
    job_id=$(rails "puts NotificationJob.perform_async('$event_id')")
    sleep 7
    retried=$(rails "puts Sidekiq::RetrySet.new.any? { |job| job.jid == '$job_id' }")
    [ "$retried" = true ] || { echo "Notification did not enter the Sidekiq retry set" >&2; exit 1; }
    $compose start localstack >/dev/null
    stopped_localstack=false
    attempts=0
    until curl -fsS http://localhost:4566/_localstack/health >/dev/null 2>&1; do
      attempts=$((attempts + 1))
      [ "$attempts" -lt 30 ] || { echo "LocalStack did not recover" >&2; exit 1; }
      sleep 1
    done
    rails "NotificationJob.new.perform('$event_id'); Sidekiq::RetrySet.new.find { |job| job.jid == '$job_id' }&.delete"
    echo "Verified a failed AWS call entered Sidekiq retries and succeeded after LocalStack recovered"
    ;;
  invalid-event)
    $compose exec -T localstack awslocal sqs purge-queue --queue-url http://localhost:4566/000000000000/busybee-deliveries-dlq >/dev/null
    $compose exec -T localstack awslocal sqs set-queue-attributes --queue-url http://localhost:4566/000000000000/busybee-deliveries --attributes VisibilityTimeout=1 >/dev/null
    queue_visibility_changed=true
    send_event '{"event_id":"not-a-uuid","recipient":{"phone":"not-a-phone"}}'
    attempts=0
    while [ "$attempts" -lt 30 ]; do
      receipt=$($compose exec -T localstack awslocal sqs receive-message --queue-url http://localhost:4566/000000000000/busybee-deliveries-dlq --query 'Messages[0].ReceiptHandle' --output text)
      if [ "$receipt" != "None" ]; then
        echo "Invalid event reached the dead-letter queue after five receives"
        $compose exec -T localstack awslocal sqs delete-message --queue-url http://localhost:4566/000000000000/busybee-deliveries-dlq --receipt-handle "$receipt" >/dev/null
        exit 0
      fi
      attempts=$((attempts + 1))
      sleep 1
    done
    echo "Timed out waiting for the invalid event to reach the dead-letter queue" >&2
    exit 1
    ;;
  *)
    echo "Usage: script/demo {happy-path|no-courier|slow-routing|circuit-open|duplicate-event|lock-contention|queue-backlog|aws-retry|invalid-event}" >&2
    exit 2
    ;;
esac
